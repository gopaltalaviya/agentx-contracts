# Secrets and wiring ONLY. Chain facts live in config/networks.json,
# protocol parameters in config/params.<chainId>.json, and contract
# addresses in deployments/<chainId>.json. See docs/08.

# RPC overrides (optional — registry defaults are used when empty)
RPC_URL_10143=https://testnet-rpc.monad.xyz
RPC_URL_143=https://rpc.monad.xyz

# Contract verification on the Monad explorer (confirm whether one is needed)
EXPLORER_API_KEY=

# Deploy key. NEVER commit a real value. Prefer --ledger or --interactive.
# The AGENTX working agreement is that the key holder runs deploys locally.
DEPLOYER_PRIVATE_KEY=
