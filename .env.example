# ─────────────────────────────────────────────────────────────────────────
# AGENTX contracts — copy to `.env` and fill in.
#
# `.env` is gitignored in this repo (verified). `.env.example` ships with
# EMPTY values and must never contain a real key.
#
# Secrets and wiring ONLY. Chain facts live in config/networks.json,
# protocol parameters in config/params.<chainId>.json, and contract addresses
# in deployments/<chainId>.json — see docs/08.
# ─────────────────────────────────────────────────────────────────────────

# ── RPC ──────────────────────────────────────────────────────────────────
RPC_URL_10143=https://testnet-rpc.monad.xyz
RPC_URL_143=https://rpc.monad.xyz

# ── Explorer verification ────────────────────────────────────────────────
# Only needed for `make verify`. Deploys work without it.
EXPLORER_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# TESTNET KEYS — Monad testnet (10143) ONLY
#
# These four wallets are testnet-only and must never hold mainnet value.
# Addresses are recorded in ../PROGRESS.md; the keys stay here.
#
# Claude uses these for deploys and end-to-end runs on testnet. It will not
# use them against mainnet (143) without asking first, per-action.
# ─────────────────────────────────────────────────────────────────────────

# Deploys every contract and holds DEFAULT_ADMIN_ROLE / ARBITER_ROLE.
# 0xd5b812EFb94124E737c3520739d04539a8441137
DEPLOYER_PRIVATE_KEY=

# Tops up agent wallets with MON for gas.
# 0x5c03DB6fb41c0F42777dDE051d07EAb9F54fCc54
FUNDER_PRIVATE_KEY=

# The orchestrator / client agent in the demo.
# 0xfB95885d3A72A82836f3fCAC720Bf80A4155F6c2
AGENT_A_PRIVATE_KEY=

# The worker agent in the demo.
# 0x2Ff72eE6B8de27dD8F2D9FbFf7102EfbaD8D37D6
AGENT_B_PRIVATE_KEY=

# ── Protocol roles ───────────────────────────────────────────────────────
# Both default to DEPLOYER when unset. Fine for the MVP, and documented as a
# limitation: the arbiter is a single key, not a multisig.
ARBITER_ADDRESS=
FEE_RECIPIENT=

# ─────────────────────────────────────────────────────────────────────────
# MAINNET — leave empty.
#
# Deliberately separate from the testnet keys above so a copy-paste cannot
# put a mainnet key where a testnet one belongs. `make deploy-mainnet` asks
# for confirmation before it will run at all.
# ─────────────────────────────────────────────────────────────────────────
MAINNET_DEPLOYER_PRIVATE_KEY=
